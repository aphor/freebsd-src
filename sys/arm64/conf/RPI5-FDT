#
# RPI5-FDT -- Raspberry Pi 5 (BCM2712 + RP1), Device Tree enumeration only.
#
# Deliberately does NOT include BROADCOM.  BROADCOM includes std.broadcom,
# which supplies both "device acpi" and "options SOC_BRCM_BCM2837" /
# "SOC_BRCM_BCM2838", and neither can be taken back out with nodevice:
#
#  - device acpi is the thing this configuration exists to do without.  With
#    ACPI tables present, bus_probe() in sys/arm64/arm64/machdep.c prefers
#    them unless kern.cfg.order says otherwise.
#  - the BCM2837/BCM2838 SoC options build the Pi 3 / Pi 4 drivers.  Those
#    match nodes in the Pi 5 vendor DTB and do attach under FDT, and
#    bcm2835_fbd then reaches the VideoCore mailbox DMA helper.
#    bcm283x_get_current_memcfg() in sys/arm/broadcom/bcm2835/bcm2835_vcbus.c
#    has entries for bcm2835/2709/2836/2837/2711/2838 but not brcm,bcm2712,
#    so it panics on purpose: "No suitable SOC memory configuration found."
#    Measured on dunn 2026-09-18; see doc/FDT_BOOT.md in rpi5_modules.git.
#
# So this config takes std.arm64 + std.dev and adds only what the Pi 5 needs.
#
# Select FDT enumeration at boot with kern.cfg.order=fdt while ACPI tables are
# still being supplied by EDK2.  Once the firmware hands off directly to a
# FreeBSD loader there will be no ACPI tables and no need for the tunable.

#NO_UNIVERSE

cpu		ARM64
ident		RPI5-FDT

include		"std.arm64"
include		"std.dev"

options 	FDT

# Serial console.  The PL011 at 0x107d001000 is a native BCM2712 peripheral,
# not behind RP1/PCIe, and is already what hw.uart.console points at.
device		pl011

# SD and SDIO host controllers, both native BCM2712 peripherals rather than
# anything behind RP1.  Nothing in FreeBSD matched brcm,bcm2712-sdhci before
# sdhci_bcm2712, which is why an FDT boot had no root filesystem to find.
device		sdhci
device		sdhci_bcm2712		# BCM2712 SD/SDIO host controller (FDT)

# The CYW43455 WiFi part is on SDIO, and dev/sdio is only built with MMCCAM,
# so the Pi 5 uses the CAM-based MMC stack rather than the classic one.
options 	MMCCAM
nodevice	mmc
nodevice	mmcsd

# BCM2712 SoC
device		bcm2712			# PWM + thermal sensor
device		bcm2712_pcie		# RP1 GEM interrupt router (FDT)
device		rpi5_fan		# Pi 5 cooling fan thermal control
device		rpi_fw			# VPU firmware mailbox, TryBoot
device		brcmstb_gpio		# SoC-native GPIO (WL_ON, SD power)
device		bcm2712_pinctrl		# SoC pin mux (SDIO2 for WiFi)
device		brcmstb_reset		# SW_INIT reset controller (PCIe bridge resets)
device		brcmstb_rescal		# SATA/PCIe resistor calibration ("rescal" reset)
device		bcm2712_pcib		# PCIe host controller (M2 phase 1: adopts a trained link)
device		bcm2712_mip		# MSI for PCIe1/PCIe2 (brcm,bcm2712-mip; M2 phase 4)
device		rp1			# RP1 on PCIe2: owns BAR1, publishes it to the RP1 drivers

# RP1 southbridge
device		rp1_gpio		# GPIO + pinctrl
device		rp1_eth			# Gigabit Ethernet (Cadence GEM)
device		rp1_pcie2_recon		# PCIe2 host controller diagnostics

# 802.11 stack, required by the statically linked cyw(4) driver
device		wlan
device		wlan_wep
device		wlan_tkip
device		wlan_ccmp
device		wlan_gcmp
device		wlan_amrr

# On-board radio
device		cyw			# CYW43455 SDIO WiFi

# USB ethernet
device		uether

# Build kernel.bin as well: an arm64 Image with a booti header, generated by
# sys/tools/arm_kernel_boothdr.awk.  Needed for the non-EFI loader work (M3).
makeoptions	WITH_KERNEL_BIN=1
