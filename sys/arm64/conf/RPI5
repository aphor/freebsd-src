#
# RPI5 -- Raspberry Pi 5 (BCM2712 + RP1) kernel configuration for FreeBSD/arm64
#
# Device Tree enumeration only: there is no ACPI in this kernel.  The DTB
# comes from the VPU firmware, either directly (rpiboot.bin, the FreeBSD
# loader booted as an arm64 Image) or passed through by a boot loader that
# supplies a devicetree.
#
# For more information on this file, please read the config(5) manual page,
# and/or the handbook section on Kernel Configuration Files:
#
#    https://docs.freebsd.org/en/books/handbook/kernelconfig/#kernelconfig-config
#
# Deliberately does NOT include BROADCOM.  BROADCOM includes std.broadcom,
# which supplies both "device acpi" and "options SOC_BRCM_BCM2837" /
# "SOC_BRCM_BCM2838", and neither can be taken back out with nodevice:
#
#  - with device acpi and ACPI tables present, bus_probe() in
#    sys/arm64/arm64/machdep.c prefers ACPI unless kern.cfg.order says
#    otherwise.
#  - the BCM2837/BCM2838 SoC options build the Pi 3 / Pi 4 drivers.  Those
#    match nodes in the Pi 5 vendor DTB and do attach under FDT, and
#    bcm2835_fbd then reaches the VideoCore mailbox DMA helper.
#    bcm283x_get_current_memcfg() in sys/arm/broadcom/bcm2835/bcm2835_vcbus.c
#    has entries for bcm2835/2709/2836/2837/2711/2838 but not brcm,bcm2712,
#    so it panics on purpose: "No suitable SOC memory configuration found."
#
# So this config takes std.arm64 + std.dev and adds only what the Pi 5 needs.
#
# ZFS is not compiled in.  A ZFS root needs zfs.ko preloaded by the loader
# (rpiboot.bin carries it on its memory disk).
#

#NO_UNIVERSE

cpu		ARM64
ident		RPI5

include		"std.arm64"
include		"std.dev"

options 	FDT

# Serial console.  The PL011 at 0x107d001000 is a native BCM2712 peripheral,
# not behind RP1/PCIe.
device		pl011

# SD and SDIO host controllers, both native BCM2712 peripherals rather than
# anything behind RP1.
device		sdhci
device		sdhci_bcm2712		# BCM2712 SD/SDIO host controller (FDT)

# The CYW43455 WiFi part is on SDIO, and dev/sdio is only built with MMCCAM,
# so the Pi 5 uses the CAM-based MMC stack rather than the classic one.
options 	MMCCAM
nodevice	mmc
nodevice	mmcsd

# BCM2712 SoC
device		bcm2712			# PWM + thermal sensor
device		bcm2712_pcie		# RP1 GEM interrupt router
device		rpi5_fan		# Pi 5 cooling fan thermal control
device		rpi_fw			# VPU firmware mailbox, TryBoot
device		brcmstb_gpio		# SoC-native GPIO (WL_ON, SD power)
device		bcm2712_pinctrl		# SoC pin mux (SDIO2 for WiFi)
device		brcmstb_reset		# SW_INIT reset controller (PCIe bridge resets)
device		brcmstb_rescal		# SATA/PCIe resistor calibration ("rescal" reset)
device		bcm2712_pcib		# PCIe host controller (brcm,bcm2712-pcie)
device		bcm2712_mip		# MSI for PCIe1/PCIe2 (brcm,bcm2712-mip)
device		rp1			# RP1 on PCIe2: owns BAR1, publishes it to the RP1 drivers
device		dwc3			# RP1 USB 3 hosts (snps,dwc3) on the rp1 simplebus

# RP1 southbridge
device		rp1_gpio		# GPIO + pinctrl
device		rp1_eth			# Gigabit Ethernet (Cadence GEM)
# rp1_pcie2_recon is not built in: it reads PCIe2's host bridge registers,
# which bcm2712_pcib owns, and RP1 at the address EDK2 used to assign.  Its
# module still builds for diagnostics on a kernel without bcm2712_pcib.

# 802.11 stack, required by the statically linked cyw(4) driver
device		wlan			# 802.11 support
options 	IEEE80211_DEBUG		# enable debug msgs
options 	IEEE80211_SUPPORT_MESH	# enable 802.11s draft support
device		wlan_wep		# 802.11 WEP support
device		wlan_tkip		# 802.11 TKIP support
device		wlan_ccmp		# 802.11 CCMP support
device		wlan_gcmp		# 802.11 GCMP support
device		wlan_amrr		# AMRR transmit rate control algorithm

# On-board radio
device		cyw			# CYW43455 SDIO WiFi

# USB ethernet
device		uether

# Build kernel.bin as well: an arm64 Image with a booti header, generated by
# sys/tools/arm_kernel_boothdr.awk.
makeoptions	WITH_KERNEL_BIN=1
